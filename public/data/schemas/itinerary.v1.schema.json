{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://maxhenneberg.github.io/travel-app/data/schemas/itinerary.v1.schema.json", "title":"Trailbook itinerary schema v1.1", "type":"object", "additionalProperties":false,
