{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxhenneberg.github.io/travel-app/data/schemas/itinerary.v1.1.schema.json",
  "title": "Trailbook itinerary schema v1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "trip"],
  "properties": { "schemaVersion": { "const": "1.1.0" }, "trip": { "$ref": "#/$defs/trip" } },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "dateTime": { "type": "string", "format": "date-time" },
    "endpoint": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "$ref": "#/$defs/text" }, "station": { "$ref": "#/$defs/text" }, "terminal": { "$ref": "#/$defs/text" }, "address": { "$ref": "#/$defs/text" }, "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 }, "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 } } },
    "image": { "type": "object", "additionalProperties": false, "required": ["alt"], "oneOf": [{ "properties": { "url": {} }, "required": ["url"] }, { "properties": { "provider": {}, "commonsFile": {} }, "required": ["provider", "commonsFile"] }, { "properties": { "provider": {}, "commonsQuery": {} }, "required": ["provider", "commonsQuery"] }], "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "provider": { "const": "wikimediaCommons" }, "commonsFile": { "$ref": "#/$defs/text" }, "commonsQuery": { "$ref": "#/$defs/text" }, "alt": { "type": "string" }, "caption": { "$ref": "#/$defs/text" }, "credit": { "$ref": "#/$defs/text" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" } } },
    "stop": { "type": "object", "additionalProperties": false, "required": ["id", "type", "title", "startsAt"], "properties": { "id": { "$ref": "#/$defs/text" }, "type": { "const": "stop" }, "title": { "$ref": "#/$defs/text" }, "startsAt": { "$ref": "#/$defs/dateTime" }, "endsAt": { "$ref": "#/$defs/dateTime" }, "category": { "$ref": "#/$defs/text" }, "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 }, "location": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/text" }, "images": { "type": "array", "items": { "$ref": "#/$defs/image" } } } },
    "segment": { "type": "object", "additionalProperties": false, "required": ["id", "mode", "from", "to"], "properties": { "id": { "$ref": "#/$defs/text" }, "mode": { "$ref": "#/$defs/mode" }, "from": { "$ref": "#/$defs/endpoint" }, "to": { "$ref": "#/$defs/endpoint" }, "departure": { "$ref": "#/$defs/dateTime" }, "arrival": { "$ref": "#/$defs/dateTime" }, "duration": { "$ref": "#/$defs/text" }, "operator": { "$ref": "#/$defs/text" }, "service": { "$ref": "#/$defs/text" }, "platform": { "$ref": "#/$defs/text" }, "terminal": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/text" }, "reservation": { "$ref": "#/$defs/text" } } },
    "mode": { "enum": ["walk", "bicycle", "car", "taxi", "bus", "tram", "metro", "subway", "train", "ferry", "flight", "other"] },
    "transit": { "type": "object", "additionalProperties": false, "required": ["id", "type", "title", "fromStopId", "toStopId", "from", "to", "mode"], "properties": { "id": { "$ref": "#/$defs/text" }, "type": { "const": "transit" }, "title": { "$ref": "#/$defs/text" }, "fromStopId": { "$ref": "#/$defs/text" }, "toStopId": { "$ref": "#/$defs/text" }, "from": { "$ref": "#/$defs/endpoint" }, "to": { "$ref": "#/$defs/endpoint" }, "mode": { "$ref": "#/$defs/mode" }, "departure": { "$ref": "#/$defs/dateTime" }, "arrival": { "$ref": "#/$defs/dateTime" }, "duration": { "$ref": "#/$defs/text" }, "operator": { "$ref": "#/$defs/text" }, "service": { "$ref": "#/$defs/text" }, "platform": { "$ref": "#/$defs/text" }, "terminal": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/text" }, "reservation": { "$ref": "#/$defs/text" }, "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } } } },
    "day": { "type": "object", "additionalProperties": false, "required": ["id", "date", "items"], "properties": { "id": { "$ref": "#/$defs/text" }, "date": { "type": "string", "format": "date" }, "title": { "$ref": "#/$defs/text" }, "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 }, "items": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/stop" }, { "$ref": "#/$defs/transit" }] } } } },
    "trip": { "type": "object", "additionalProperties": false, "required": ["id", "title", "startDate", "endDate", "timeZone", "days"], "properties": { "id": { "$ref": "#/$defs/text" }, "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" }, "startDate": { "type": "string", "format": "date" }, "endDate": { "type": "string", "format": "date" }, "timeZone": { "$ref": "#/$defs/text" }, "countryCode": { "type": "string", "minLength": 2, "maxLength": 2 }, "days": { "type": "array", "items": { "$ref": "#/$defs/day" } } } }
  }
}
