{
  "id": "./",
  "name": "Trailbook Travel Itinerary",
  "short_name": "Trailbook",
  "description": "Keep your travel plans readable and available offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#102a25",
  "theme_color": "#16302b",
  "share_target": {
    "action": "./?share-target=itinerary",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "itinerary", "accept": ["application/json", ".json"] }] }
  },
  "icons": [
    { "src": "icons/travel-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/travel-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
