{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxhenneberg.github.io/travel-app/data/schemas/itinerary.v1.schema.json",
  "title": "Travel itinerary schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trip"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "trip": { "$ref": "#/$defs/trip" }
  },
  "$defs": {
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "startDate", "endDate", "timeZone", "days"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "timeZone": { "type": "string", "minLength": 1 },
        "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "activities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string", "minLength": 1 },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "startsAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "startsAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" },
        "category": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/image" }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alt"],
      "oneOf": [
        { "properties": { "url": {} }, "required": ["url"] },
        { "properties": { "provider": {}, "commonsFile": {} }, "required": ["provider", "commonsFile"] },
        { "properties": { "provider": {}, "commonsQuery": {} }, "required": ["provider", "commonsQuery"] }
      ],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "provider": { "const": "wikimediaCommons" },
        "commonsFile": { "type": "string", "minLength": 1 },
        "commonsQuery": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "caption": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
